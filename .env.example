# 鲸鱼娘余额挂件 · 原型配置（全部可选，留空即用默认值）
# 复制为 .env 后由启动脚本或 shell 读入；本文件只写变量名，不含任何真实密钥。

# DeepSeek API 密钥（https://platform.deepseek.com/api_keys 创建）
# 不配也能跑：provider 自动退回 mock，用假余额演示整套交互。
DEEPSEEK_API_KEY=

# 监听地址与端口。默认只绑回环，别在公网机器上改成 0.0.0.0（写接口靠回环判定权限）。
DSHW_HOST=127.0.0.1
DSHW_PORT=3080

# 数据目录：余额账本与外观设置落在这里（默认系统临时目录下的 dshw-proto）
# 作为 DSH 插件跑时默认改成 $DSH_HOME/whale-widget，跟着宿主的家走；这里显式设了就以这里为准。
# DSHW_DATA_DIR=D:\Plugins\dshw-data

# provider：auto（默认，有 key 走 deepseek）| deepseek | mock
DSHW_PROVIDER=auto

# 上游地址与超时（改了上游地址就等于改了密钥的去处，所以默认锁官方端点）
DSHW_UPSTREAM_BASE_URL=https://api.deepseek.com
DSHW_UPSTREAM_TIMEOUT_MS=8000

# 轮询间隔（毫秒），对齐参考项目的 60 秒
DSHW_INTERVAL_MS=60000

# 写操作放行名单（逗号分隔），默认空=只有本机回环能改配置
# DSHW_ADMIN_HOSTS=192.0.2.10:3080,myhost.lan

# 挂件外观默认值（之后可以在菜单里改，改动会存进数据目录）
DSHW_SCALE=1
DSHW_SNAP_MODE=ratio
DSHW_SNAP_VALUE=0.08
DSHW_MIRROR_ON_LEFT=1
DSHW_HIDE_MENU=0

# mock 专用：按脚本回放余额，`!code` 表示这一拍模拟一次失败
# 例：100,99.5,98.2,!timeout,98.0  —— 用于测试「抖动沿用最近余额」和数字滚动
# DSHW_MOCK_SCRIPT=100,99.5,98.2,!timeout

# 日志级别：info（默认）| silent
# DSHW_LOG_LEVEL=info

# ---- 作为 DSH 插件跑时（宿主注入，一般不用自己设）----
# 余额优先取宿主已登录账号（ctx.deepseekAccount），其次宿主凭据库里的 DEEPSEEK_API_KEY，
# 最后才是上面这个环境变量。所以插件形态下留空是正常的，不代表没配好。
# DSH_CLIENT_VERSION —— 桌面主进程注入的客户端版本，作为账号接口的 client.version 上报
# DSHW_CLIENT_LOCALE —— 同上接口的 locale，默认取系统 locale
# DSH_HOME —— 宿主的家目录（本机 D:\dsh），参与数据目录推导
